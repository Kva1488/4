      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.1,
          "Spread": 0.7
        }
      },
      "DepthOfField": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "FarIntensity": 0.15,
          "FocusDistance": 60,
          "InFocusRadius": 80,
          "NearIntensity": 0
        }
      }
