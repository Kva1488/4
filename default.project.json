            10
          ],
          "Duration": 8
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "ClockTime": 17.6,
        "GeographicLatitude": 20,
        "Brightness": 2.5,
        "ExposureCompensation": 0.15,
        "Ambient": [
          0.25,
          0.18,
          0.2
        ],
        "OutdoorAmbient": [
          0.45,
          0.32,
          0.32
        ],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.26,
          "Offset": 0.15,
          "Color": [
            0.85,
